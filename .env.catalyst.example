# ═══════════════════════════════════════════════════════
# IntelliCon Catalyst Deployment Environment
# Copy this to .env.catalyst and fill in your values
# ═══════════════════════════════════════════════════════

# Docker image (push to Docker Hub or your registry)
DOCKER_IMAGE=intellicon/catalyst
DOCKER_TAG=latest

# ─── Catalyst AppSail ───
# Your Slate frontend URL (for CORS_ORIGINS)
SLATE_URL=https://YOUR-SLATE-URL.catalystslate.com

# ─── Database credentials ───
POSTGRES_DB=intellicon
POSTGRES_USER=intellicon
POSTGRES_PASSWORD=generate-a-strong-password-here

# ─── Neo4j ───
NEO4J_USER=neo4j
NEO4J_PASSWORD=generate-a-strong-password-here

# ─── Redis ───
REDIS_PASSWORD=generate-a-strong-password-here

# ─── Auth ───
# Must be 32+ characters, random string
JWT_SECRET_KEY=generate-a-random-32-char-string-here

# ─── LLM Provider ───
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-openai-api-key-here

# ─── Seed passwords (for initial user setup) ───
SEED_ADMIN_PASSWORD=generate-a-strong-password-here
SEED_INVESTIGATOR_PASSWORD=generate-a-strong-password-here
SEED_SUPERVISOR_PASSWORD=generate-a-strong-password-here
