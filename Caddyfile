{$DOMAIN:localhost} {
    # Global security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # WebSocket route: no rate limit (long-lived connection)
    # Must be declared BEFORE /api/* because Caddy handle blocks are
    # exclusive and matched in declaration order.
    handle /api/chat/ws {
        reverse_proxy backend:8000 {
            transport http {
                read_timeout 86400s
            }
        }
    }

    # API routes: stricter rate limit (30 req/min per IP)
    handle /api/* {
        rate_limit {
            zone api {
                key {remote_host}
                events 30
                window 1m
            }
        }

        reverse_proxy backend:8000
    }

    # Everything else → frontend
    handle {
        reverse_proxy frontend:3000
    }
}
