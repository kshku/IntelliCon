# =============================================================================
# IntelliCon Production Environment Configuration
# =============================================================================
# This file provides a reference for production deployment settings.
# NEVER commit actual production secrets to version control.
#
# Usage:
#   1. Copy this file to .env on your production server
#   2. Generate secure values using: python -c "import secrets; print(secrets.token_hex(32))"
#   3. Fill in all required values
# =============================================================================

# Environment (must be "production")
ENVIRONMENT=production

# Domain and HTTPS (required for Caddy)
DOMAIN=your-domain.com
ACME_EMAIL=your-email@example.com

# JWT Secret (REQUIRED - generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=generate-a-strong-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# LLM Provider (REQUIRED - get from your provider)
# Supported: openai, anthropic, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here

# PostgreSQL (REQUIRED - use strong passwords)
POSTGRES_DB=intellicon
POSTGRES_USER=intellicon
POSTGRES_PASSWORD=generate-strong-password-here
DATABASE_URL=postgresql://intellicon:generate-strong-password-here@postgres:5432/intellicon

# Neo4j (REQUIRED - use strong passwords)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=generate-strong-password-here

# Redis (REQUIRED - use strong password)
REDIS_PASSWORD=generate-strong-password-here
REDIS_URL=redis://:generate-strong-password-here@redis:6379/0

# CORS Origins (REQUIRED - comma-separated list of your domains)
# Example: CORS_ORIGINS=["https://app.your-domain.com","https://admin.your-domain.com"]
CORS_ORIGINS=["https://your-domain.com"]

# Agent Configuration
AGENT_MAX_ITERATIONS=10
SQL_QUERY_TIMEOUT=30
SQL_MAX_ROWS=1000

# Seed Passwords (change for production!)
SEED_ADMIN_PASSWORD=generate-strong-password-here
SEED_INVESTIGATOR_PASSWORD=generate-strong-password-here
SEED_SUPERVISOR_PASSWORD=generate-strong-password-here
