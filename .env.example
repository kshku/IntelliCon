# =============================================================================
# IntelliCon Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file to version control.
#
# Generate secure values with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# Production domain (required for HTTPS)
DOMAIN=localhost
ACME_EMAIL=

# REQUIRED: Set a strong random secret for JWT signing.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# LLM Provider Configuration
# Supported: openai, anthropic, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here

# PostgreSQL — must match POSTGRES_USER/POSTGRES_PASSWORD below for DATABASE_URL
POSTGRES_DB=intellicon
POSTGRES_USER=intellicon
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://intellicon:change-me-in-production@localhost:5432/intellicon

# Neo4j — must match NEO4J_USER/NEO4J_PASSWORD below for NEO4J_URI
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-production

# Redis — password must match REDIS_PASSWORD
REDIS_PASSWORD=change-me-in-production
REDIS_URL=redis://:change-me-in-production@localhost:6379/0

# Agent Configuration
AGENT_MAX_ITERATIONS=10
SQL_QUERY_TIMEOUT=30
SQL_MAX_ROWS=1000

# CORS Origins (comma-separated for production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Seed Passwords (change for production!)
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_INVESTIGATOR_PASSWORD=change-me-in-production
SEED_SUPERVISOR_PASSWORD=change-me-in-production
