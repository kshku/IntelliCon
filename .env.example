# LLM Provider Configuration
# Supported: openai, anthropic, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here

# PostgreSQL
POSTGRES_DB=intellicon
POSTGRES_USER=intellicon
POSTGRES_PASSWORD=intellicon
DATABASE_URL=postgresql://intellicon:intellicon@localhost:5432/intellicon

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=intellicon

# Redis
REDIS_URL=redis://localhost:6379/0

# Agent Configuration
AGENT_MAX_ITERATIONS=10
SQL_QUERY_TIMEOUT=30
SQL_MAX_ROWS=1000

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
